<Application x:Class="Deskify.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: the main window is created in App.xaml.cs OnStartup, but only
         after the single-instance check passes and the chosen theme's brushes are
         merged (so Styles.xaml resolves them). A second launch signals the running
         instance and exits without ever creating a window. -->
</Application>
