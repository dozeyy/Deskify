<Window x:Class="Deskify.UI.QuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Switch" Width="480" Height="440"
        Icon="pack://application:,,,/Assets/deskify.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="14" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="SearchBox" FontSize="15" Padding="12,10"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="Search projects…" FontSize="15" Margin="13,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                        <Condition Binding="{Binding IsFocused, ElementName=SearchBox}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No projects match."
                       Style="{StaticResource Muted}" Margin="4,16,0,0" Visibility="Collapsed" />
            <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowHover}" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonUp="ResultRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IcoPin}" Width="12" Height="12" Margin="0,0,8,0"
                                          VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}"
                                          Visibility="{Binding PinnedVisibility}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
