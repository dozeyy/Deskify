<Window x:Class="Deskify.UI.CloseOthersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Other Apps" Width="620" Height="520"
        Icon="pack://application:,,,/Assets/deskify.ico"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="Close other apps?" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="DontAskCheck" Content="Don't ask me again — always close without confirming"
                      Margin="2,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Dim}" FontSize="12" />
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostBtn}"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Grid.Column="2" x:Name="ConfirmBtn" Style="{StaticResource DangerBtn}"
                        MinWidth="140" Click="Confirm_Click" />
            </Grid>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WindowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                              Checked="Item_CheckChanged" Unchecked="Item_CheckChanged" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="18" Height="18"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="2" Margin="10,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ExeName}" Style="{StaticResource Dim}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
