<Window x:Class="Deskify.UI.LoadingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setting up your workspace"
        WindowStyle="None" AllowsTransparency="True" Background="#00000000"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        ResizeMode="NoResize" Opacity="0"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{DynamicResource TextBrush}">

    <!-- Translucent scrim over the whole (multi-monitor) desktop: dims and blocks the
         windows shuffling into place behind it, but stays see-through so the user can
         watch their workspace assemble. -->
    <Grid Background="#B4000000">
        <!-- The scrim fills every monitor, but the card is centered on the PRIMARY
             display only. PrimaryMonitorArea is sized and offset in code-behind to
             exactly the primary monitor, so "Center" always lands in the middle of the
             main screen no matter how many monitors are connected or how they're placed. -->
        <Grid x:Name="PrimaryMonitorArea" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="44,36" MinWidth="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- macOS/Windows-style spinner: a ring of 12 tapered spokes whose
                         brightness fades from faint to solid white, forming a "comet head".
                         Rotating the whole ring at a constant rate sweeps that bright head
                         smoothly around the circle. 52x52 keeps the original overall size. -->
                    <Canvas Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinRotate" CenterX="26" CenterY="26" />
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.12">
                            <Rectangle.RenderTransform><RotateTransform Angle="0" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.16">
                            <Rectangle.RenderTransform><RotateTransform Angle="30" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.20">
                            <Rectangle.RenderTransform><RotateTransform Angle="60" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.26">
                            <Rectangle.RenderTransform><RotateTransform Angle="90" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.32">
                            <Rectangle.RenderTransform><RotateTransform Angle="120" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.40">
                            <Rectangle.RenderTransform><RotateTransform Angle="150" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.50">
                            <Rectangle.RenderTransform><RotateTransform Angle="180" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.60">
                            <Rectangle.RenderTransform><RotateTransform Angle="210" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.72">
                            <Rectangle.RenderTransform><RotateTransform Angle="240" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.84">
                            <Rectangle.RenderTransform><RotateTransform Angle="270" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="0.92">
                            <Rectangle.RenderTransform><RotateTransform Angle="300" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Canvas.Left="24.6" Canvas.Top="4" Width="2.8" Height="8" RadiusX="1.4" RadiusY="1.4" Fill="White" Opacity="1.0">
                            <Rectangle.RenderTransform><RotateTransform Angle="330" CenterX="1.4" CenterY="22" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>

                    <TextBlock Text="Setting up your workspace" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusLine" Text="Opening your apps…" FontSize="13.5" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Text="Please wait — don't move your windows until this finishes."
                               FontSize="12" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" MaxWidth="300" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SpinRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
