<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         THEME: Light — Dark theme inverted. Same monochrome roles, flipped:
         near-white background, near-black text/accent. No hue.
         ===================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="PanelBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="#E4E4E4" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#4F4F4F" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A7A7A" />

    <!-- Accent: the darkest tone — the one element allowed to pop
         against the light chrome, mirroring the dark theme's accent role. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerBrush" Color="#B23A33" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2F7D53" />

</ResourceDictionary>
