<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         THEME: Dark — default
         Base palette: #121212 black · #444444 dark gray · #888888 mid gray ·
         #B0B0B0 light gray · #E0E0E0 near-white. No hue — depth via lightness only.
         ===================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#121212" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardBrush" Color="#444444" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#505050" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="#282828" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888" />

    <!-- Accent: the lightest tone, not a hue — the one element allowed to pop
         against the dark chrome, per the monochrome-minimalism brief. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#121212" />

    <SolidColorBrush x:Key="DangerBrush" Color="#C77A73" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FA98F" />

</ResourceDictionary>
