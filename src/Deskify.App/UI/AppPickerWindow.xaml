<Window x:Class="Deskify.UI.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Application" Width="620" Height="580"
        Icon="pack://application:,,,/Assets/deskify.ico"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False" Opacity="0">

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Add application" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Apps installed on your PC — desktop programs and Microsoft Store apps. Search, pick one or more, or browse for anything not listed." />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="32,8,10,8" TextChanged="SearchBox_TextChanged" />
                <Path Data="{StaticResource IcoSearch}" Width="15" Height="15" Margin="10,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Search apps" Margin="33,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                        <Condition Binding="{Binding IsFocused, ElementName=SearchBox}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Click="Browse_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcoFolder}" Width="15" Height="15" />
                    <TextBlock Text="Browse…" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Style="{StaticResource Dim}" FontSize="12" />
            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostBtn}"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Grid.Column="3" x:Name="AddBtn" Content="Add Selected" Style="{StaticResource AccentBtn}"
                    MinWidth="120" IsEnabled="False" Click="Add_Click" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46" Margin="0,1" Cursor="Hand"
                                      MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <!-- Hover fill fades in/out independently of the
                                         checked/selected state below it. -->
                                    <Border x:Name="HoverBg" Background="{DynamicResource CardAltBrush}"
                                            CornerRadius="10" Opacity="0" />
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" Focusable="False" />
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="12,0,0,0"
                                                   FontSize="13.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Grid.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Grid.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="No matching applications." Style="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
