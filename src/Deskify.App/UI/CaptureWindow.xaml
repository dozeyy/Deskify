<Window x:Class="Deskify.UI.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Current Session" Width="620" Height="520"
        Icon="pack://application:,,,/Assets/deskify.ico"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Running applications" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Select the windows to include. Their current position and size are captured as the layout." />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcoRefresh}" Width="15" Height="15" />
                    <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource Dim}" Margin="12,0" FontSize="12" />
            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostBtn}"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Grid.Column="3" x:Name="AddBtn" Content="Add Selected" Style="{StaticResource AccentBtn}"
                    MinWidth="120" IsEnabled="False" Click="Add_Click" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WindowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                              Checked="Item_CheckChanged" Unchecked="Item_CheckChanged" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="18" Height="18"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="2" Margin="10,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ExePath}" Style="{StaticResource Dim}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding MonitorText}" FontSize="11"
                                                   Foreground="{DynamicResource TextDimBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
