# Build output
bin/
obj/
out/

# Installer payload (generated by installer/build-installer.ps1)
installer/Deskify.Setup/payload/_publish/
installer/Deskify.Setup/payload/*.zip

# IDE
.vs/
*.user

# macOS app build output
macos/.build/
macos/build/
macos/.swiftpm/
.DS_Store

# Generated by XcodeGen (`xcodegen generate`) — the source of truth is project.yml
macos/Deskify.xcodeproj/

# App-icon PNGs are generated from Resources/deskify-icon.png by
# scripts/make-icons.sh; only the master PNG and Contents.json are tracked.
macos/Resources/Assets.xcassets/AppIcon.appiconset/*.png
